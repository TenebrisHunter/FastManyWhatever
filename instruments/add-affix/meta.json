{
  "id": "add-affix",
  "name": {
    "ru": "Добавить строку или слово",
    "en": "Add Prefix/Suffix"
  },
  "description": {
    "ru": "Добавляет слово в начало или в конец имени каждого выбранного файла или папки",
    "en": "Adds a word at the start or end of every selected name"
  },
  "hint": {
    "ru": "Не забудьте про пробел в слове, если он нужен (например, '_' или ' ' между старым и новым именем)",
    "en": "Don't forget a space in the word if you need one (e.g. '_' or ' ' between old and new name)"
  },
  "scripts": {
    "windows": "tool.ps1",
    "unix": "tool.sh"
  },
  "supports_preview": true,
  "supports_undo": true,
  "default_dry_run": true,
  "accepts": ["files", "dirs"],
  "params": [
    {
      "id": "word",
      "label": { "ru": "Слово", "en": "Word" },
      "type": "text",
      "required": true,
      "placeholder": { "ru": "например, '_' или '_old'", "en": "e.g. '_' or '_old'" }
    },
    {
      "id": "pos",
      "label": { "ru": "Позиция", "en": "Position" },
      "type": "choice",
      "options": [
        { "value": "prefix", "label": { "ru": "В начало", "en": "At start" } },
        { "value": "suffix", "label": { "ru": "В конец",  "en": "At end" } }
      ],
      "default": "prefix"
    }
  ]
}